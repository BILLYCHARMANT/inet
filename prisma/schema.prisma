// NextAuth.js + Prisma schema
// https://authjs.dev/reference/adapter/prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MENTOR
  USER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // for credentials provider only
  role          Role      @default(USER)
  accounts      Account[]
  sessions      Session[]
  applications  Application[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

enum CallType {
  PROJECT
  APPLICATION
  COMPETITION
  EVENT
}

model CallForApplication {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  type        CallType  @default(APPLICATION)
  summary     String?
  description String?
  imageUrl    String?
  deadline    DateTime?
  published   Boolean   @default(false)
  status      String    @default("draft") // draft | open | closed
  formSchema  Json?     // [{ id, type, label, required?, placeholder?, options?, accept? }]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  applications Application[]
}

model Application {
  id             String   @id @default(cuid())
  callId         String
  call           CallForApplication @relation(fields: [callId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name           String   // display name (from submitterName or "Anonymous")
  email          String   // display email (from submitterEmail or "")
  submitterName  String?
  submitterEmail String?
  data           Json?    // form answers { [fieldId]: value }
  content        String?  // legacy
  status         String   @default("pending")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
