# Copy this file to .env on your Hostinger server and fill in the values.
# Do not commit .env to git.

# Database – from Hostinger MySQL (enable Remote MySQL and add your server IP)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# NextAuth – generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-at-least-32-chars"

# Your live site URL (no trailing slash)
NEXTAUTH_URL="https://yourdomain.com"

# Optional: OAuth (set redirect URIs to https://yourdomain.com/api/auth/callback/google and /api/auth/callback/github)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_ID=""
GITHUB_SECRET=""
